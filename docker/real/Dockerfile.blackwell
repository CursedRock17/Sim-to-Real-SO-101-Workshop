FROM nvidia/cuda:13.0.0-devel-ubuntu24.04

ARG GROOT_REF=ead52833afbbf4243f8cd5e7664f48a94de03b19

ENV DEBIAN_FRONTEND=noninteractive

# ------------------------------------------------------------------
# System dependencies + Python 3.10
# ------------------------------------------------------------------
RUN apt-get update && apt-get install -y \
    software-properties-common \
    build-essential \
    cmake \
    git \
    sed \
    && add-apt-repository ppa:deadsnakes/ppa \
    && apt-get update && apt-get install -y \
    python3.10 \
    python3.10-dev \
    python3.10-venv \
    && rm -rf /var/lib/apt/lists/*

RUN update-alternatives \
    --install /usr/bin/python3 python3 /usr/bin/python3.10 1

COPY docker/utils.sh /root/tmp/utils.sh

RUN cat /root/tmp/utils.sh >> /root/.bashrc && \
    rm /root/tmp/utils.sh

RUN python3.10 -m ensurepip --upgrade && \
    python3.10 -m pip install --upgrade \
        pip \
        setuptools \
        wheel \
        packaging \
        ninja

RUN apt-get remove -y \
        python3-cryptography \
        python3-cryptography-dev \
        2>/dev/null || true

RUN python3 -m pip install \
    --ignore-installed \
    cryptography

# ------------------------------------------------------------------
# Constraints
# ------------------------------------------------------------------
RUN echo "" > /tmp/constraints.txt

# ------------------------------------------------------------------
# Isaac-GR00T
# ------------------------------------------------------------------
RUN git clone \
    https://github.com/NVIDIA/Isaac-GR00T.git \
    /Isaac-GR00T

WORKDIR /Isaac-GR00T

RUN git checkout "${GROOT_REF}" && \
    git rev-parse HEAD

# Remove x86-only dependencies
RUN sed -i '/flash-attn==/d' pyproject.toml && \
    sed -i '/triton==/d' pyproject.toml

# Install core package
RUN pip install -e . --no-deps

# Install SO100 eval package
RUN cd gr00t/eval/real_robot/SO100 && \
    pip install -e .

# ------------------------------------------------------------------
# CUDA environment
# ------------------------------------------------------------------
ENV CUDA_HOME=/usr/local/cuda
ENV PATH=$CUDA_HOME/bin:$PATH
ENV LD_LIBRARY_PATH=$CUDA_HOME/lib64:$LD_LIBRARY_PATH

# ------------------------------------------------------------------
# PyTorch CUDA 13 nightly
# ------------------------------------------------------------------
RUN python3 -m pip uninstall -y \
        torch \
        torchvision \
        torchaudio || true

RUN python3 -m pip install --pre \
        torch \
        torchvision \
        torchaudio \
        --index-url https://download.pytorch.org/whl/nightly/cu130

# ------------------------------------------------------------------
# ML stack
# ------------------------------------------------------------------
RUN pip install \
    tyro \
    accelerate \
    einops \
    safetensors \
    huggingface_hub \
    scipy \
    sentencepiece \
    dm-tree \
    albumentations \
    peft \
    lmdb

RUN pip uninstall -y \
        transformers \
        tokenizers

RUN pip install --no-cache-dir \
        transformers==4.51.3 \
        tokenizers==0.21.4

RUN export MAX_JOBS=2 && \
    python3 -m pip install \
        flash-attn \
        --no-build-isolation \
        --no-cache-dir

# ------------------------------------------------------------------
# Hardware SDK
# ------------------------------------------------------------------
RUN pip install feetech-servo-sdk

# ------------------------------------------------------------------
# GUI dependencies
# ------------------------------------------------------------------
RUN apt-get update && apt-get install -y \
    libx11-6 \
    libxcb1 \
    libxkbcommon0 \
    libxkbcommon-x11-0 \
    libgl1 \
    libegl1 \
    libxrandr2 \
    libxinerama1 \
    libxcursor1 \
    libxi6 \
    lsof \
    neovim \
    ffmpeg \
    libavcodec-dev \
    libavformat-dev \
    libavutil-dev \
    && rm -rf /var/lib/apt/lists/*

# Lerobot Setup
WORKDIR /workspace
RUN rm -rf /workspace/lerobot_attention_visualizer
RUN git clone https://github.com/huggingface/lerobot.git
RUN git clone https://github.com/CursedRock17/lerobot_attention_visualizer.git

WORKDIR /workspace/lerobot_attention_visualizer
RUN git checkout so101_nvidia
RUN python3 -m pip install --no-deps -e '.[smolvla]'

WORKDIR /workspace/lerobot
RUN git checkout e670ac5daf9b76

# Pin packages already in the base image to prevent upgrades that break
# Isaac Lab's internal symlinks (packaging, numpy, lxml, torch, etc.)
RUN printf '%s\n' \
    "packaging==23.0" \
    "numpy==1.26.0" \
    "lxml==4.9.4" \
    "imageio==2.37.0" \
    > /tmp/constraints.txt

# Install lerobot without deps to avoid upgrading packages that break
# Isaac Lab's symlinked vendored copies (packaging, numpy, torch, etc.)
RUN python3 -m pip install --no-deps -e .

# Install only the deps not already in the base image
RUN python3 -m pip install -c /tmp/constraints.txt \
    "datasets>=4.0.0,<4.2.0" \
    "diffusers>=0.27.2,<0.36.0" \
    "huggingface-hub[hf-transfer,cli]>=0.34.2,<0.36.0" \
    "accelerate>=1.10.0,<2.0.0" \
    "cmake>=3.29.0.1,<4.2.0" \
    "av>=15.0.0,<16.0.0" \
    "jsonlines>=4.0.0,<5.0.0" \
    "pynput>=1.7.7,<1.9.0" \
    "pyserial>=3.5,<4.0" \
    "wandb>=0.20.0,<0.22.0" \
    "num2words" \
    "torchcodec>=0.2.1,<0.16.0" \
    "draccus==0.10.0" \
    "deepdiff>=7.0.1,<9.0.0" \
    "feetech-servo-sdk>=1.0.0,<2.0.0"

WORKDIR /workspace/lerobot_attention_visualizer
